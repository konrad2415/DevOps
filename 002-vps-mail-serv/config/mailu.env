cat mailu.env 
###################################
# Mailu - ztech.us.ci
###################################

# Secret used by Mailu for sessions/authentication.
# Replace with output of: openssl rand -hex 16
SECRET_KEY=REEMPLAZAR_SECRET_KEY

###################################
# Networking
###################################

# Must not overlap with your VPS/VPC/Docker networks.
SUBNET=192.168.203.0/24

###################################
# Mail identity
###################################

DOMAIN=ztech.us.ci

# IMPORTANT:
# First hostname = canonical Mailu SMTP/IMAP identity.
# Second hostname = public client/webmail hostname.
HOSTNAMES=mail.ztech.us.ci

POSTMASTER=admin

###################################
# TLS
###################################

TLS_FLAVOR=letsencrypt

###################################
# Authentication protection
###################################

AUTH_RATELIMIT_IP=10/hour
AUTH_RATELIMIT_USER=100/day

###################################
# Optional features
###################################

ADMIN=true
WEBMAIL=roundcube
API=true

# Not needed for this first POC.
WEBDAV=none
FETCHMAIL_ENABLED=False

# Antivirus enabled.
ANTIVIRUS=clamav

# Macro scanning.
SCAN_MACROS=false

###################################
# Mail settings
###################################

MESSAGE_SIZE_LIMIT=50000000

# Maximum messages sent by one mailbox per day.
MESSAGE_RATELIMIT=200/day

# NEVER configure RELAYNETS unless there is a deliberate reason.
RELAYNETS=

# No external relay/smarthost.
RELAYHOST=

RECIPIENT_DELIMITER=+

# DMARC aggregate/forensic reports.
DMARC_RUA=dmarc # ithas automatically the @ and the rest of the domain 
DMARC_RUF=dmarc

###################################
# Mailbox features
###################################

WELCOME=false

# Full-text search.
FULL_TEXT_SEARCH=en

###################################
# Web
###################################

WEBROOT_REDIRECT=/webmail

WEB_ADMIN=/admin

WEB_WEBMAIL=/webmail

WEB_API=/api

SITENAME=ZTech Mail

WEBSITE=https://mail.ztech.us.ci

###################################
# Advanced
###################################

COMPOSE_PROJECT_NAME=mailu

CREDENTIAL_ROUNDS=12

REAL_IP_HEADER=
REAL_IP_FROM=

REJECT_UNLISTED_RECIPIENT=yes

LOG_LEVEL=INFO

TZ=America/Havana

DEFAULT_SPAM_THRESHOLD=80

###################################
# REST API
###################################

# Replace with output of:
# openssl rand -hex 32
API_TOKEN=REEMPLAZAR_API_TOKEN

###################################
# Automatic administrator
###################################

INITIAL_ADMIN_ACCOUNT=admin
INITIAL_ADMIN_DOMAIN=ztech.us.ci

# Replace with generated password.
INITIAL_ADMIN_PW=REEMPLAZAR_ADMIN_PASSWORD

# Do not recreate/reset the password on every restart.
INITIAL_ADMIN_MODE=ifmissing

PORTS=25,80,443,465,993,4190,143,587
