acl "lan" {
    172.18.0.0/24;
};

acl "ns2" {
    172.18.0.3;
};

include "/etc/bind/rndc.key";	
controls {
    inet 127.0.0.1 port 953
        allow { 127.0.0.1; } keys { "rndc-key"; };
};
 
options {
	directory "/var/cache/bind";
    // Escuchar en loopback y en la IP del contenedor
    listen-on { any; };   # { 127.0.0.1; 172.18.0.2; };
    listen-on-v6 { none; };

    // Recursion solo para la LAN
    recursion yes;
    allow-recursion { any; };    //{ lan; };
    allow-query { any; };        //{ lan; };
    allow-query-cache { any; };         //{ lan; };

    // Transferencias de zona solo a ns2
    allow-transfer { ns2; };

    // Notificaciones a ns2 cuando cambie una zona
    notify yes;
    also-notify { 172.18.0.3; };

    // Ocultar información del servidor
    version none;
    hostname none;
    server-id none;

    // Reenviadores para consultas externas (opcional)
    forwarders {   
        8.8.8.8;
        1.1.1.1;
    };

};
