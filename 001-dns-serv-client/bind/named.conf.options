acl "lan" {
    172.18.0.0/24;
};

acl "ns2" {
    172.18.0.4;
};


options {
	directory "/var/cache/bind";
    // Escuchar en loopback y en la IP del contenedor
    listen-on { 127.0.0.1; 172.18.0.2; };
    listen-on-v6 { none; };

    // Recursión solo para la LAN
    recursion yes;
    allow-recursion { lan; };
    allow-query     { lan; };
    allow-query-cache { lan; };

    // Transferencias de zona solo a ns2
    allow-transfer { ns2; };

    // Notificaciones a ns2 cuando cambie una zona
    notify yes;
    also-notify { 172.18.0.4; };

    // Ocultar información del servidor
    version none;
    hostname none;
    server-id none;

    // Reenviadores para consultas externas (opcional)
    forwarders {
        8.8.8.8;
        1.1.1.1;
    };

};
